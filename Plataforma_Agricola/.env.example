# Copie este archivo como .env (instalar.ps1 lo genera automaticamente).
DJANGO_SECRET_KEY=cambiar
DJANGO_DEBUG=False
# Dominio publico asignado por ngrok (lo completa iniciar_plataforma.ps1).
