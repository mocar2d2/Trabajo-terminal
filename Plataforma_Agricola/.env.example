COOKIES_SEGURAS=True
SECURE_HSTS_SECONDS=3600
SECURE_SSL_REDIRECT=True
AVISO_ACTUALIZACION=False
PRECIOS_CSV=Precios_Historicos_SNIIM_Continuo.csv
CLIMA_CSV=Clima_Municipios_Top50_Semanal_v1.csv
# Carpeta opcional con los insumos originales para comparar sus hashes.
INSUMOS_ORIGINALES_DIR=
